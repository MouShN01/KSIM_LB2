<?xml version="1.0" encoding="utf-8"?><model version="NetLogo 7.0.4" snapToGrid="false" nlw-version="2.16.2 (b307ada7)">
  <code><![CDATA[turtles-own [
  activation-tick  ;; first tick when this ant can move
  age              ;; number of completed ticks since this ant appeared
]
globals [
  food-in-nest
]
patches-own [
  chemical             ;; amount of chemical on this patch
  food                 ;; total food on this patch, including dropped units
  nest?                ;; true on nest patches, false elsewhere
  nest-scent           ;; number that is higher closer to the nest
  food-source-number   ;; original source number (1..6), or 0 outside the sources
]

;;;;;;;;;;;;;;;;;;;;;;;;
;;; Setup procedures ;;;
;;;;;;;;;;;;;;;;;;;;;;;;

to setup
  clear-all
  set food-in-nest 0
  set-default-shape turtles "bug"
  create-turtles population
  [ 
    set size 2         ;; easier to see
    set color red  ;; red = not carrying food
    set activation-tick who + 1  ;; preserves gradual departure of the initial ants
    set age random ant-lifespan  ;; assigns a random initial age
  ]   
  setup-patches
  reset-ticks
end

to setup-patches
  ask patches
  [ setup-nest
    setup-food
    recolor-patch ]
end

to setup-nest  ;; patch procedure
  ;; set nest? variable to true inside the nest, false elsewhere
  set nest? (distancexy 0 0) < 5
  ;; spread a nest-scent over the whole world -- stronger near the nest
  set nest-scent 200 - distancexy 0 0
end

to setup-food  ;; patch procedure
  let positions [
    ;; possible food source centers
    [21 0]
    [-21 -21]
    [-28 28]
    [21 21]
    [0 -28]
    [-21 0]
  ]
  set food-source-number 0
  let i 0
  while [i < food-source-count] ;; iterates through a number of centers equal to the number selected via the slider
  [
    let source-position item i positions ;; retrieves a list element
    ;; for each cell, the distance to the center is checked
    if (distancexy (item 0 source-position)
                   (item 1 source-position)) < 5
    [
      set food-source-number i + 1
    ]
    set i i + 1
  ]
  ;; source cells randomly receive one or two units of food
  if food-source-number > 0
  [
    set food one-of [1 2]
  ]
end

to recolor-patch  ;; patch procedure
  ifelse food > 0
  [
    ifelse food-source-number = 0
    [
      set pcolor white  ;; marks dropped food outside the initial sources
    ]
    [
      if food-source-number = 1 [ set pcolor cyan ]
      if food-source-number = 2 [ set pcolor sky ]
      if food-source-number = 3 [ set pcolor blue ]
      if food-source-number = 4 [ set pcolor yellow ]
      if food-source-number = 5 [ set pcolor pink ]
      if food-source-number = 6 [ set pcolor orange ]
    ]
  ]
  [
    ifelse nest?
    [
      set pcolor violet  ;; shows the nest when no loose food covers this patch
    ]
    [
      set pcolor scale-color green chemical 0.1 5  ;; shows the chemical trail
    ]
  ]
end

;;;;;;;;;;;;;;;;;;;;;
;;; Go procedures ;;;
;;;;;;;;;;;;;;;;;;;;;

to go  ;; forever button
  ask turtles
  [ if ticks < activation-tick [ stop ]  ;; waits until this ant becomes active
    ifelse color = red
    [ look-for-food  ]       ;; not carrying food? look for it
    [ return-to-nest ]       ;; carrying food? take it back to nest
    wiggle
    fd 1 ]
  ask turtles
  [
    age-and-die  ;; ages all existing ants, including those waiting in the nest
  ]
  reproduce-ants  ;; creates at most one new ant per tick
  diffuse chemical (diffusion-rate / 100)
  ask patches
  [ set chemical chemical * (100 - evaporation-rate) / 100  ;; slowly evaporate chemical
    recolor-patch ]
  tick
end

to age-and-die  ;; turtle procedure
  set age age + 1  ;; completes one tick of this ant's life

  if age >= ant-lifespan
  [
    if color = orange + 1
    [
      ask patch-here
      [
        set food food + 1  ;; returns the carried unit without replacing existing food
        recolor-patch  ;; makes the dropped food visible immediately
      ]
    ]

    die  ;; removes the ant after its carried food has been returned
  ]
end

to reproduce-ants  ;; observer procedure
  if reproduction? and (food-in-nest >= birth-cost)
  [
    set food-in-nest food-in-nest - birth-cost  ;; spends food on one new ant

    create-turtles 1
    [
      setxy 0 0  ;; places the new ant in the nest
      set size 2
      set color red  ;; the new ant starts without food
      set activation-tick ticks + 1  ;; starts moving on the next tick
      set age 0  ;; newborn ants begin with zero age
    ]
  ]
end

to return-to-nest  ;; turtle procedure
  ifelse nest?
  [ 
    set food-in-nest food-in-nest + 1 ;; when an ant is in the nest, we add to the value
    set color red
    rt 180 
  ]
  [ 
    set chemical chemical + 60  ;; drop some chemical
    uphill-nest-scent ;; head toward the greatest value of nest-scent
  ]         
end

to look-for-food  ;; turtle procedure
  if food > 0
  [ set color orange + 1     ;; pick up food
    set food food - 1        ;; and reduce the food source
    rt 180                   ;; and turn around
    stop ]
  ;; go in the direction where the chemical smell is strongest
  if (chemical >= 0.05) and (chemical < 2)
  [ uphill-chemical ]
end

;; sniff left and right, and go where the strongest smell is
to uphill-chemical  ;; turtle procedure
  let scent-ahead chemical-scent-at-angle   0
  let scent-right chemical-scent-at-angle  45
  let scent-left  chemical-scent-at-angle -45
  if (scent-right > scent-ahead) or (scent-left > scent-ahead)
  [ ifelse scent-right > scent-left
    [ rt 45 ]
    [ lt 45 ] ]
end

;; sniff left and right, and go where the strongest smell is
to uphill-nest-scent  ;; turtle procedure
  let scent-ahead nest-scent-at-angle   0
  let scent-right nest-scent-at-angle  45
  let scent-left  nest-scent-at-angle -45
  if (scent-right > scent-ahead) or (scent-left > scent-ahead)
  [ ifelse scent-right > scent-left
    [ rt 45 ]
    [ lt 45 ] ]
end

to wiggle  ;; turtle procedure
  rt random 40
  lt random 40
  if not can-move? 1 [ rt 180 ]
end

to-report nest-scent-at-angle [angle]
  let p patch-right-and-ahead angle 1
  if p = nobody [ report 0 ]
  report [nest-scent] of p
end

to-report chemical-scent-at-angle [angle]
  let p patch-right-and-ahead angle 1
  if p = nobody [ report 0 ]
  report [chemical] of p
end


; Copyright 1997 Uri Wilensky.
; See Info tab for full copyright and license.]]></code>
