plotxy ticks sum [food] of patches with [food-source-number = 0]</update>
      </pen>
    </plot>
    <monitor x="5" precision="0" y="495" height="60" fontSize="11" width="100" display="Food in nest">food-in-nest</monitor>
    <slider x="7" step="1" y="565" max="6" width="250" display="food-source-count" height="50" min="0" direction="Horizontal" default="3" variable="food-source-count"/>
    <switch x="375" y="565" height="40" on="true" variable="reproduction?" width="115" display="reproduction?"/>
    <slider x="505" step="1" y="565" max="10" width="250" display="birth-cost" height="50" min="1" direction="Horizontal" default="10" variable="birth-cost"/>
    <plot x="5" autoPlotX="true" yMax="200" autoPlotY="true" yAxis="ants" y="705" xMin="0" height="260" legend="true" xMax="100" yMin="0" width="750" xAxis="ticks" display="Ant population">
      <setup/>
      <update/>
      <pen interval="1" mode="0" display="ants" color="-13345367" legend="true">
